{
  "description": "Two devices edit one goal without seeing each other. `at` is when the user made the edit, in minutes; edits reach the server in the order listed. Every sync engine must produce these results (Python here; the Swift engine later).",
  "start": {"name": "Root", "description": "Original", "deadline": null},
  "cases": [
    {"name": "different fields both apply",
     "edits": [{"at": 1, "set": {"name": "Mac"}}, {"at": 2, "set": {"description": "Phone"}}],
     "result": {"name": "Mac", "description": "Phone"}, "lost": []},
    {"name": "the later edit arrives last and wins",
     "edits": [{"at": 1, "set": {"description": "Mac"}}, {"at": 2, "set": {"description": "Phone"}}],
     "result": {"description": "Phone"}, "lost": ["Mac"]},
    {"name": "the later edit arrives first and still wins",
     "edits": [{"at": 2, "set": {"description": "Mac"}}, {"at": 1, "set": {"description": "Phone"}}],
     "result": {"description": "Mac"}, "lost": ["Phone"]},
    {"name": "a tie keeps the one that arrived last",
     "edits": [{"at": 1, "set": {"description": "Mac"}}, {"at": 1, "set": {"description": "Phone"}}],
     "result": {"description": "Phone"}, "lost": ["Mac"]},
    {"name": "the same edit twice is no clash",
     "edits": [{"at": 1, "set": {"description": "Same"}}, {"at": 2, "set": {"description": "Same"}}],
     "result": {"description": "Same"}, "lost": []},
    {"name": "a field resent unchanged never undoes the other edit",
     "edits": [{"at": 1, "set": {"description": "Mac"}}, {"at": 9, "set": {"name": "Phone", "description": "Original"}}],
     "result": {"name": "Phone", "description": "Mac"}, "lost": []},
    {"name": "clearing a field is an edit",
     "edits": [{"at": 1, "set": {"description": "Mac"}}, {"at": 2, "set": {"description": ""}}],
     "result": {"description": ""}, "lost": ["Mac"]},
    {"name": "an empty field sent as empty is unchanged",
     "edits": [{"at": 1, "set": {"deadline": "2030-01-02"}}, {"at": 2, "set": {"name": "Phone", "deadline": null}}],
     "result": {"name": "Phone", "deadline": "2030-01-02T00:00:00Z"}, "lost": []},
    {"name": "the same day as a date and as a time is no clash",
     "edits": [{"at": 1, "set": {"deadline": "2030-01-02"}}, {"at": 2, "set": {"deadline": "2030-01-02T00:00:00Z"}}],
     "result": {"deadline": "2030-01-02T00:00:00Z"}, "lost": []},
    {"name": "one field loses while its neighbour applies",
     "edits": [{"at": 5, "set": {"description": "Mac"}}, {"at": 1, "set": {"name": "Phone", "description": "Phone"}}],
     "result": {"name": "Phone", "description": "Mac"}, "lost": ["Phone"]},
    {"name": "three edits leave the latest",
     "edits": [{"at": 1, "set": {"name": "A"}}, {"at": 3, "set": {"name": "C"}}, {"at": 2, "set": {"name": "B"}}],
     "result": {"name": "C"}, "lost": ["A", "B"]}
  ]
}
