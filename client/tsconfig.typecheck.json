{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "strict": false
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/utils/api/**/*.js",
    "src/hooks/queryKeys.js",
    "src/utils/programViewModel.js",
    "src/utils/programCalendarStreaks.js",
    "src/utils/programDayState.js",
    "src/utils/dateRange.js",
    "src/utils/sessionTime.js",
    "src/utils/durationStats.js",
    "src/utils/progressAggregations.js",
    "src/utils/goalConditions.js",
    "src/utils/goalConditionSeries.js",
    "src/utils/goalTreeCache.js",
    "src/utils/goalHierarchyFilters.js",
    "src/utils/goalDeadlineRules.js",
    "src/utils/goalDueFormat.js",
    "src/utils/goalSequenceOrder.js",
    "src/components/common/calendarHeatmapModel.js",
    "src/utils/noteTypes.js",
    "src/offline/outbox.js",
    "src/offline/outboxTransport.js",
    "src/offline/opKinds.js",
    "src/offline/queryPersistence.js",
    "src/offline/idbKeyValue.js",
    "src/offline/memoryStore.js",
    "src/offline/sessionCache.js",
    "src/offline/sessionOps.js",
    "src/offline/connectivity.js",
    "src/offline/userSnapshot.js",
    "src/offline/circuitIds.js",
    "src/offline/progressChartOps.js",
    "src/offline/quickSessionDraft.js",
    "src/offline/serviceWorker.js",
    "src/offline/outboxTypes.js"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.js",
    "**/*.test.jsx"
  ]
}
