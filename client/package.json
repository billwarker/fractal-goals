{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate:og-image": "node scripts/generate-og-image.mjs",
    "check:responsive": "node scripts/responsive-audit.mjs",
    "check:maintainability": "node scripts/maintainability-audit.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "node scripts/run-vitest-with-timeout.mjs",
    "test:related": "node scripts/run-vitest-with-timeout.mjs --related",
    "test:coverage": "node scripts/run-vitest-with-timeout.mjs --coverage",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test --project=setup --project=desktop e2e/production.spec.js e2e/offline-session.spec.js e2e/quick-session-completion.spec.js e2e/progress-on-save.spec.js e2e/notes-page.spec.js e2e/goal-reviews.spec.js e2e/program-session-plans.spec.js e2e/settings-storage.spec.js e2e/agent-connections.spec.js",
    "sweep": "node scripts/run-sweep.mjs",
    "sweep:quick": "node scripts/run-sweep.mjs --project=sweep-setup --project=sweep-phone-light --project=sweep-phone-dark --project=sweep-desktop-light --project=sweep-desktop-dark",
    "sweep:report": "node scripts/sweep-report.mjs",
    "check:contrast": "node scripts/check-theme-contrast.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@sentry/react": "^10.38.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.2",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "date-fns": "^4.1.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.0.18"
  }
}
